{
  "name": "dr-music",
  "productName": "DR Music",
  "version": "0.2.0",
  "private": true,
  "description": "A private, offline music library with Apple Music-like Lyrics",
  "author": "suxiaofan",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "powershell -NoProfile -File scripts/build.ps1 -Run -SkipInstall",
    "test": "tsx --test tests/lyrics.test.ts tests/queue.test.ts tests/virtual.test.ts tests/library.test.ts",
    "pack": "powershell -NoProfile -File scripts/build.ps1 -SkipInstall",
    "dist": "powershell -NoProfile -File scripts/build.ps1 -SkipInstall -Package",
    "notices": "node scripts/licenses.mjs",
    "test:smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@applemusic-like-lyrics/core": "0.6.0",
    "@applemusic-like-lyrics/lyric": "1.1.0",
    "lucide-react": "^0.468.0",
    "motion": "^14.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.56.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
